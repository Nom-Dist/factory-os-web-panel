HOST=127.0.0.1
PORT=3000
# Generate two DIFFERENT random secrets (at least 32 characters).
# BRIDGE_TOKEN is only for the OpenComputers server. Never prefix with NEXT_PUBLIC_.
BRIDGE_TOKEN=
# PANEL_TOKEN signs sessions; this is NOT the login password.
PANEL_TOKEN=
# Create with npm run password:hash. Keep single quotes around the hash.
PANEL_PASSWORD_HASH=''
# Set the public HTTPS origin when running behind a reverse proxy.
PUBLIC_ORIGIN=http://localhost:3000
